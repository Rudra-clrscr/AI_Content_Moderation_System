# BONC moderation API, as a systemd service on a Contabo VPS (Debian/Ubuntu).
#
#   sudo cp deploy/bonc-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now bonc-api
#   journalctl -u bonc-api -f
#
# Paths assume the checkout is at /opt/bonc with the venv at /opt/bonc/.venv. Change User,
# Group and the three paths if it lives elsewhere.

[Unit]
Description=BONC content moderation API
Documentation=file:///opt/bonc/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=bonc
Group=bonc
WorkingDirectory=/opt/bonc/flask_api

# Secrets (ADMIN_TOKEN, DB_*) live here, not in this unit file: systemd units are
# world-readable and `systemctl show` prints Environment= lines back to any user.
EnvironmentFile=/opt/bonc/flask_api/.env

ExecStart=/opt/bonc/.venv/bin/gunicorn -c /opt/bonc/deploy/gunicorn.conf.py wsgi:app

# BOTH MODELS OR NOTHING. Without this the service starts happily with the image model
# missing - /ready still says "ready", and every picture publishes unexamined. See
# scripts/check_deploy.py for why that is the failure worth blocking on.
ExecStartPre=/opt/bonc/.venv/bin/python /opt/bonc/flask_api/scripts/check_deploy.py

Restart=on-failure
RestartSec=10
# Loading 1.24 GB of ONNX from a cold VPS disk is not quick.
TimeoutStartSec=600
TimeoutStopSec=90

# Hardening. The service writes only to data/ (SQLite) and reads models/ and config/.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/bonc/flask_api/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

# onnxruntime spawns its own pool; left unbounded it opens one thread per core per session and
# they fight each other. Two, not four: the measured host has 4 cores already shared with
# nginx, coturn, a dotnet service and four other gunicorn masters, so taking every core for
# inference starves them. media.visual.intra_op_threads in settings.yaml covers the image side.
Environment=OMP_NUM_THREADS=2

# ---- MEMORY: THIS SERVICE MUST DIE BEFORE ANYTHING ELSE DOES ----------------------------
# Measured on the target host: 7.8 GB total, 4.7 GB already used by the services that were
# there first, 3.1 GB available, and NO SWAP. Both models are 1.24 GB resident plus about
# 0.25 GB of Python and gunicorn, so one worker fits in roughly 1.5 GB with headroom to
# spare - but only just, and only at one worker. Video is not checked at all since the
# transcription path was removed, so there is no Whisper model on top of this any more.
#
# With no swap, a global out-of-memory event is resolved by the kernel killing whichever
# process scores worst, and that score tracks RSS. The largest process on this box is the
# 2.5 GB gunicorn belonging to the AI search. Without the three lines below, the first time
# anything spikes, the kernel's answer would be to kill the SEARCH to make room for us.
#
#   MemoryHigh   reclaim pressure starts here - the service is throttled, not killed
#   MemoryMax    hard ceiling: exceed it and only THIS service is killed
#   OOMScoreAdj  and if the whole box runs out anyway, volunteer this service first
MemoryHigh=1536M
MemoryMax=2G
OOMScoreAdjust=500

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bonc-api

[Install]
WantedBy=multi-user.target
