# Copy to flask_api/.env on the server, fill in the secrets, then `chmod 600`.
#
#     install -m 600 /dev/null /opt/bonc/flask_api/.env
#     # paste, fill in, save
#
# Values below are set for the surveyed host (vmi3527693: 4 cores, 7.8 GB, no swap, nginx in
# front, ports 8000-8003 already taken). Anything marked CHANGE ME has no safe default.

# ---- secrets ------------------------------------------------------------------------
# Admin endpoints accept this as X-Admin-Token for scripts; the dashboard uses a session.
ADMIN_TOKEN=CHANGE_ME

# SQL Server sink. The ODBC Driver 18 this needs is already installed on the host.
# Set RESULT_SINK=log instead if this host should not write to SQL Server at all - then
# decisions go to the log and to the dashboard's own SQLite audit table, and nowhere else.
DB_SERVER=CHANGE_ME
DB_NAME=CHANGE_ME
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
# RESULT_SINK=log

# ---- where it listens -----------------------------------------------------------------
# 8000, 8001, 8002 and 8003 are all held by gunicorn masters that were here first.
GUNICORN_BIND=127.0.0.1:8004

# One worker. Both models are 1.24 GB resident and each worker loads its own copy, so two
# workers need 2.94 GB against the 3.1 GB this box has available - and there is no swap.
GUNICORN_WORKERS=1
GUNICORN_THREADS=4

# ---- what runs ------------------------------------------------------------------------
# Text and image moderation only. There is no video setting any more: the transcription path
# was removed from the repository, and an uploaded video is decided by
# media.allow_unchecked_video in settings.yaml (shipped true, so videos publish and record
# checked: false).

# Four cores, already shared with nginx, coturn, a dotnet service and four other gunicorn
# masters. Taking every core for inference starves them.
OMP_NUM_THREADS=2

# ---- REQUIRED because nginx is in front -----------------------------------------------
# nginx listens on 80/443 on this host. This is NOT in .env - it belongs in
# config/settings.yaml, and it is listed here only so the deploy does not forget it:
#
#     trust_proxy_hops: 1
#
# Left at 0, every moderation decision records nginx's address instead of the author's: the
# audit log fills with one address and the dashboard's Block button then refuses everybody.
# The service logs a warning once if it sees X-Forwarded-For arriving while this is 0.
