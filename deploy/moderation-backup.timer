[Unit]
Description=Daily backup of the moderation API's data

[Timer]
# 03:30 server time, with a little jitter so it does not line up with other tenants' jobs.
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=15min
# If the box was off at 03:30, run at the next boot instead of skipping the day.
Persistent=true

[Install]
WantedBy=timers.target
