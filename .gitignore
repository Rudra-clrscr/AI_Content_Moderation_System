# Training data. The source datasets are inputs we don't redistribute, and synthetic_v4.csv is
# regenerated exactly by `python training/synth_data.py --seed 4`, so none of it belongs in git.
res/

# Superseded model bundles. Only the live bundle (models/v5) and the triage filter are tracked;
# v1, v3 and v4 are kept on the machines that need them for rollback or comparison. Their objects
# are still in this repo's LFS history from earlier commits — removing them from tracking does
# not reclaim that storage, which would need a history rewrite.
flask_api/models/v1/
flask_api/models/v3/
flask_api/models/v4/
flask_api/models/v4.backup_pre_v5/

# OCR recognition models for scripts RapidOCR doesn't bundle. Third-party weights we don't
# redistribute, fetched by `python scripts/fetch_ocr_langs.py <script>` and verified against
# the SHA256 RapidOCR publishes.
flask_api/models/ocr/

# The image model (app/clip.py). A separate bundle from the text model in models/v5 - CLIP
# weights we don't redistribute, fetched and SHA256-verified by `python scripts/fetch_clip.py`.
# prompts.npz and model_meta.json are built from config/visual_policy.yaml, which IS tracked,
# so the policy is reviewable in git while the 352 MB encoder is not.
flask_api/models/img_v1/

# Test output directories
flask_api/scripts/test_generated_pdfs/
flask_api/scripts/test_stress_pdfs/
flask_api/scripts/test_50_negatives_gen/
flask_api/scripts/*.json
flask_api/scripts/*.txt

# Image datasets for the visual check (app/clip.py). Third-party photographs under their own
# licences, some of it graphic by design, plus BONC's own listing pictures — inputs we don't
# redistribute, exactly like res/ above. `python flask_api/scripts/eval_clip_images.py` reads
# them from here; images/labels.csv records where each one came from.
images/

# NSFW reference classifier (scripts/fetch_nsfw_reference.py). A second opinion used only by
# scripts/eval_sexual_label.py to measure the `sexual` label's recall - nothing in app/ loads
# it, and the service runs identically without it. Third-party weights we don't redistribute.
flask_api/models/nsfw_ref/
