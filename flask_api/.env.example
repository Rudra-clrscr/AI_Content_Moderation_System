# Copy to flask_api/.env and edit. The real .env is gitignored; this file is not, so it must
# never hold a real secret. app/config.py's module docstring lists every variable the service
# reads - this is only the handful you need to get a local instance doing something useful.

# OPTIONAL. The Admin page now uses email + password login (see the ADMIN LOGIN section below).
# This token only lets scripts call /v1/admin/* with an X-Admin-Token header. With no token AND no
# administrator created, those endpoints answer 404 on purpose. Generate one with:
#     python -c "import secrets; print(secrets.token_hex(16))"
ADMIN_TOKEN=

# Where finished results go. "log" needs no database and is the quickest way to run locally;
# "sql" writes to dbo.moderation_events and needs the DB_ settings below.
RESULT_SINK=log

# SQL Server. Leave DB_USER unset for Windows auth (Trusted_Connection).
# Create the table first:  sqlcmd -S "$DB_SERVER" -d "$DB_NAME" -i flask_api/sql/create_table.sql
#DB_SERVER=localhost\SQLEXPRESS
#DB_NAME=bonc
#DB_USER=
#DB_PASSWORD=

# Serves the single-page demo UI at /demo. Off by default.
#DEMO_PAGE=1

# ---------------------------------------------------------------------------------------
# ADMIN LOGIN, PASSWORD RECOVERY AND SAVED SETTINGS - full guide: flask_api/ADMIN_SETUP.md
# Placeholders only. Real values go in your own .env, never here.

# Long random text that signs the login cookie. Make one with:
#     python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 1 when served over HTTPS (production). Leave 0 for http://localhost.
SESSION_COOKIE_SECURE=0

# Used by the one-time command:  python -m app.admin_cli create-admin
# Leave the password empty and the command asks for it at a hidden prompt (better).
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_INITIAL_PASSWORD=

# SQLite file holding admin accounts and saved settings. Empty = flask_api/data/admin.db.
ADMIN_DB_PATH=

# Password-recovery email through Brevo (free plan). The sender must be verified in Brevo.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=verified-sender@example.com
EMAIL_FROM_NAME=BONC Network
