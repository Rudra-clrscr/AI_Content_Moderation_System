# Copy to flask_api/.env and edit. The real .env is gitignored; this file is not, so it must
# never hold a real secret. app/config.py's module docstring lists every variable the service
# reads - this is only the handful you need to get a local instance doing something useful.

# Enables the /v1/admin/* endpoints and the Admin page's toggle and level controls.
# UNSET IS NOT A BUG: with no token those endpoints answer 404 "admin endpoints disabled",
# deliberately, so an unconfigured deployment does not advertise that they exist. The Admin
# page reports that message as-is. Generate one with:
#     python -c "import secrets; print(secrets.token_hex(16))"
ADMIN_TOKEN=

# Where finished results go. "log" needs no database and is the quickest way to run locally;
# "sql" writes to dbo.moderation_events and needs the DB_ settings below.
RESULT_SINK=log

# SQL Server. Leave DB_USER unset for Windows auth (Trusted_Connection).
# Create the table first:  sqlcmd -S "$DB_SERVER" -d "$DB_NAME" -i flask_api/sql/create_table.sql
#DB_SERVER=localhost\SQLEXPRESS
#DB_NAME=bonc
#DB_USER=
#DB_PASSWORD=

# Serves the single-page demo UI at /demo. Off by default.
#DEMO_PAGE=1
