# Copy to flask_api/.env and edit. The real .env is gitignored; this file is not, so it must
# never hold a real secret. app/config.py's module docstring lists every variable the service
# reads - this is only the handful you need to get a local instance doing something useful.

# OPTIONAL. Lets scripts (and, until BONC_AUTH_VERIFY_URL is set, the Admin page) call
# /v1/admin/* with an X-Admin-Token header. There is no admin login on this service: admins
# sign in on BONC (see BONC_AUTH_VERIFY_URL below). With neither set, /v1/admin/* answers 404
# on purpose. Generate one with:
#     python -c "import secrets; print(secrets.token_hex(16))"
ADMIN_TOKEN=

# The bearer token the main .NET server sends to the moderation endpoints, as
# "Authorization: Bearer <this>". Blank means those endpoints are OPEN, which is what running
# locally wants - and what a deployment must not leave behind. /ready reports it as
# service_auth: "enforced" or "open" so a deploy check can tell the difference.
SERVICE_TOKEN=

# Where finished results go. "log" needs no database and is the quickest way to run locally;
# "sql" writes to dbo.moderation_events and needs the DB_ settings below.
RESULT_SINK=log

# SQL Server. Leave DB_USER unset for Windows auth (Trusted_Connection).
# Create the table first:  sqlcmd -S "$DB_SERVER" -d "$DB_NAME" -i flask_api/sql/create_table.sql
#DB_SERVER=localhost\SQLEXPRESS
#DB_NAME=bonc
#DB_USER=
#DB_PASSWORD=

# Serves the single-page demo UI at /demo. Off by default.
#DEMO_PAGE=1

# GET /docs (Swagger UI) and GET /openapi.yaml are ON by default - integrators need the
# contract, and the running service is the copy that cannot be out of date. Set this to 0 on
# an instance where even the list of endpoints should not be public.
#API_DOCS=0

# ---------------------------------------------------------------------------------------
# ADMIN - full guide: flask_api/ADMIN_SETUP.md

# SQLite file holding saved settings, the moderation log and the blocklist.
# Empty = flask_api/data/admin.db.
ADMIN_DB_PATH=

# The .NET backend's admin sign-in. When set, an admin request carrying
# "Authorization: Bearer <token>" is accepted only if this endpoint answers 200 with an
# adminId (401 = token invalid or session ended, 403 = not an admin; anything else fails
# closed with 503). HTTPS is required except for localhost. Until the .NET team publishes
# the endpoint, leave it blank and use ADMIN_TOKEN (or AUTH_DISABLED=1 on a local machine).
BONC_AUTH_VERIFY_URL=
# Which kind of endpoint the URL is:
#   verify-admin (default)  a purpose-built verifier with the contract above
#   user-detail             .NET's existing getUserDetail - this service checks the roles:
#     BONC_AUTH_VERIFY_URL=https://api.boncnetwork.com/api/userService/getUserDetail
#     BONC_AUTH_STYLE=user-detail
# BONC_AUTH_STYLE=verify-admin
# Roles that count as admin under user-detail, comma-separated (case-insensitive).
# BONC_AUTH_ADMIN_ROLES=Admin,SuperAdmin
# BONC_AUTH_METHOD=GET
# BONC_AUTH_TIMEOUT=5
# Seconds an accepted token is trusted before .NET is asked again (0 = every request).
# A BONC sign-out takes up to this long to reach this service.
# BONC_AUTH_CACHE_SECONDS=60

# Browser origins allowed to call /v1/admin/* directly, comma-separated, exact
# (e.g. https://admin.boncnetwork.com). Blank = no CORS headers; wildcards are refused.
ADMIN_CORS_ORIGINS=
